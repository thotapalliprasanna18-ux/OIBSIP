  {
   "cell_type": "markdown",
   "id": "615cbf0a",
   "metadata": {},
   "source": [
    "K-Means and the Elbow Method"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 10,
   "id": "ee48c1e5",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1400x450 with 2 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "\n",
    "df = pd.read_csv(\"Dataset (1).csv\")\n",
    "df['InvoiceDate'] = pd.to_datetime(df['InvoiceDate'], format='%d-%m-%Y %H:%M', errors='coerce')\n",
    "df = df.dropna(subset=['Customer ID','InvoiceDate'])\n",
    "df['TotalPrice'] = df['Quantity'] * df['Price per unit']\n",
    "snapshot_date = df['InvoiceDate'].max() + pd.Timedelta(days=1)\n",
    "rfm = df.groupby('Customer ID').agg({\n",
    "    'InvoiceDate': lambda x: (snapshot_date - x.max()).days,\n",
    "    'Invoice':'nunique',\n",
    "    'TotalPrice':'sum'\n",
    "}).rename(columns={'InvoiceDate':'Recency','Invoice':'Frequency','TotalPrice':'Monetary'})\n",
    "\n",
    "# STEP 2: Elbow Method\n",
    "rfm_num = rfm[[\"Recency\",\"Frequency\",\"Monetary\"]]\n",
    "rfm_log = np.log1p(rfm_num.clip(lower=0))\n",
    "X = StandardScaler().fit_transform(rfm_log)\n",
    "\n",
    "K_range = range(2,11)\n",
    "inertia, sil = [], []\n",
    "for k in K_range:\n",
    "    km = KMeans(n_clusters=k, random_state=42, n_init=10)\n",
    "    labels = km.fit_predict(X)\n",
    "    inertia.append(km.inertia_)\n",
    "    sil.append(silhouette_score(X, labels))\n",
    "\n",
    "fig, axes = plt.subplots(1,2, figsize=(14,4.5))\n",
    "axes[0].plot(list(K_range), inertia, marker=\"o\", lw=2)\n",
    "axes[0].set_title(\"Elbow Method - inertia vs K\")\n",
    "axes[1].plot(list(K_range), sil, marker=\"o\", lw=2, color=\"#DD8452\")\n",
    "axes[1].set_title(\"silhouette_score vs K\")\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "ab571135",
   "metadata": {},
   "source": [
    "Observation: Looking at both graphs, I can see that K=4 is the best choice. in the Elbow Method , the graphs starts becoming stable after K=4 ,Also, the silhoutte Score is highest at K=4."
   ]
  },
